{
  "schema_version": 2,
  "module_id": "security.center",
  "display_name": "Security Center",
  "description": "Provides bounded malware scanning, durable findings, Ubuntu posture, and reversible quarantine.",
  "module_version": "0.8.0",
  "core_api": "1",
  "capabilities": [
    {
      "id": "security.module.status",
      "description": "Read the bounded lifecycle status of the Security Center module.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "requested_permissions": ["security.read-status"]
    },
    {
      "id": "security.files.scan",
      "description": "Scan one regular file inside a trusted resource root without returning its content.",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "required": ["resource_id", "relative_path"],
        "additionalProperties": false
      },
      "requested_permissions": ["filesystem.read-metadata", "filesystem.read-content", "security.write-findings"]
    },
    {
      "id": "security.scan.run",
      "description": "Run a bounded quick or full scan profile inside one trusted resource root.",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "relative_path": {"type": "string", "maxLength": 1024},
          "mode": {"type": "string", "enum": ["quick", "full"]}
        },
        "required": ["resource_id", "mode"],
        "additionalProperties": false
      },
      "requested_permissions": ["filesystem.read-metadata", "filesystem.read-content", "security.write-findings"]
    },
    {
      "id": "security.findings.list",
      "description": "List a bounded page of metadata-only security findings.",
      "input_schema": {
        "type": "object",
        "properties": {
          "state": {"type": "string", "enum": ["active", "resolved", "ignored"]},
          "limit": {"type": "integer", "minimum": 1, "maximum": 25}
        },
        "required": [],
        "additionalProperties": false
      },
      "requested_permissions": ["security.read-findings"]
    },
    {
      "id": "security.posture.scan",
      "description": "Run six bounded read-only Ubuntu security posture checks.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "requested_permissions": ["security.read-posture"]
    },
    {
      "id": "security.quarantine.prepare",
      "description": "Prepare a reversible quarantine receipt for one active finding.",
      "input_schema": {
        "type": "object",
        "properties": {"finding_id": {"type": "integer", "minimum": 1}},
        "required": ["finding_id"],
        "additionalProperties": false
      },
      "requested_permissions": ["security.read-findings", "filesystem.read-metadata", "filesystem.read-content"]
    },
    {
      "id": "security.quarantine.commit",
      "description": "Commit an approved one-time quarantine operation.",
      "input_schema": {
        "type": "object",
        "properties": {"quarantine_id": {"type": "string", "minLength": 36, "maxLength": 36}},
        "required": ["quarantine_id"],
        "additionalProperties": false
      },
      "requested_permissions": ["filesystem.read-metadata", "filesystem.read-content", "security.write-quarantine"]
    },
    {
      "id": "security.quarantine.restore",
      "description": "Restore one approved quarantined object without overwriting an existing path.",
      "input_schema": {
        "type": "object",
        "properties": {"quarantine_id": {"type": "string", "minLength": 36, "maxLength": 36}},
        "required": ["quarantine_id"],
        "additionalProperties": false
      },
      "requested_permissions": ["security.write-quarantine", "filesystem.write-content"]
    }
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "requested_permissions": ["security.read-status", "filesystem.read-metadata", "filesystem.read-content", "filesystem.write-content", "security.write-findings", "security.read-findings", "security.read-posture", "security.write-quarantine"],
  "lifecycle": "on-demand",
  "resource_class": "tiny",
  "default_enabled": true,
  "entrypoint": {
    "kind": "python-service",
    "module": "ai_native_security",
    "python_path": "src"
  }
}

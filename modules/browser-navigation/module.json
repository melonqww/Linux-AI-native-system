{
  "schema_version": 1,
  "module_id": "browser.navigation",
  "display_name": "Browser Navigation",
  "description": "Validates and opens HTTP or HTTPS URLs in the default browser.",
  "module_version": "0.1.0",
  "core_api": "1",
  "capabilities": ["browser.url.plan", "browser.search.plan", "browser.url.open"],
  "dependencies": [],
  "optional_dependencies": ["desktop.applications"],
  "requested_permissions": ["browser.open-url"],
  "lifecycle": "on-demand",
  "resource_class": "tiny",
  "default_enabled": true,
  "entrypoint": {"kind": "python-service", "module": "ai_native_browser", "python_path": "src"},
  "intent_routes": [
    {
      "capability_id": "browser.search.plan",
      "operation": "plan_web_search",
      "description": "Search the public internet or web for a site or information explicitly requested by the user.",
      "examples": [
        "найди в интернете официальный сайт",
        "поищи это в сети",
        "выполни поиск в интернете",
        "search the web for this"
      ]
    },
    {
      "capability_id": "browser.url.plan",
      "operation": "plan_open_url",
      "description": "Open an explicit HTTP or HTTPS website address from the user.",
      "examples": [
        "открой этот сайт по ссылке",
        "перейди на https адрес",
        "open this website URL"
      ]
    }
  ]
}

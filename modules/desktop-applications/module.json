{
  "schema_version": 1,
  "module_id": "desktop.applications",
  "display_name": "Desktop Applications",
  "description": "Finds installed desktop applications and their launch metadata.",
  "module_version": "0.1.0",
  "core_api": "1",
  "capabilities": ["desktop.applications.find"],
  "dependencies": [],
  "optional_dependencies": [],
  "requested_permissions": ["applications.read-metadata"],
  "lifecycle": "on-demand",
  "resource_class": "tiny",
  "default_enabled": true,
  "entrypoint": {"kind": "python-service", "module": "ai_native_applications", "python_path": "src"},
  "intent_routes": [
    {
      "capability_id": "desktop.applications.find",
      "operation": "find_application",
      "description": "Find the installation or launcher of a desktop application on this computer.",
      "examples": [
        "найди приложение Discord",
        "где установлен Firefox",
        "покажи расположение программы",
        "find the installed application"
      ]
    }
  ]
}

{
  "id": "exact-phrase-search",
  "title": "A literal phrase request excludes documents with reordered words",
  "locale": "en",
  "tags": ["foundation", "files", "search-match", "exact-phrase"],
  "fixture": "search-match.json",
  "turns": [
    {
      "user": "Find my text files containing the exact phrase 'launch code is blue river'",
      "expect": {
        "stage": "completed",
        "capabilities": ["documents.query.search"],
        "found": 1,
        "result_paths": [
          "/home/test-user/Documents/exact.txt"
        ],
        "plan_steps_include": [
          {
            "capability": "documents.query.search",
            "arguments": {
              "text": "launch code is blue river",
              "content_match": "exact_phrase",
              "extensions": ["txt"]
            }
          }
        ],
        "approval_required": false,
        "assistant_nonempty": true
      }
    }
  ]
}

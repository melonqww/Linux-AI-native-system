{
  "id": "search-and-inspect",
  "title": "Inspection reads bounded metadata without approval",
  "locale": "ru",
  "tags": ["file-operations", "r0", "inspect", "multistep", "focused"],
  "fixture": "file-operations.json",
  "turns": [
    {
      "user": "Найди файл report.pdf",
      "expect": {
        "stage": "completed",
        "capabilities": ["documents.query.search"],
        "found": 1
      }
    },
    {
      "user": "Покажи размер и сведения о найденном файле",
      "expect": {
        "stage": "completed",
        "capabilities": ["files.items.inspect"],
        "approval_required": false,
        "affected": 1,
        "operation_actions": ["inspect_files"]
      }
    }
  ]
}

{
  "id": "search-and-move-approved",
  "title": "A trusted search result can be moved after approval",
  "locale": "ru",
  "tags": ["file-operations", "r1", "multistep", "focused"],
  "fixture": "file-operations.json",
  "turns": [
    {
      "user": "Найди файл с именем report.pdf",
      "expect": {
        "stage": "completed",
        "capabilities": ["documents.query.search"],
        "found": 1
      }
    },
    {
      "user": "Перемести найденный файл в папку Готово на рабочем столе",
      "approval": "grant",
      "expect": {
        "stage": "completed",
        "capabilities": ["files.items.move"],
        "approval_required": true,
        "affected": 1,
        "operation_actions": ["move_results"],
        "plan_steps_include": [
          {
            "capability": "files.items.move",
            "arguments": {"destination": "desktop", "directory_name": "Готово"}
          }
        ],
        "paths_exist": ["/home/test-user/Desktop/Готово/report.pdf"],
        "paths_absent": ["/home/test-user/Documents/report.pdf"]
      }
    }
  ]
}

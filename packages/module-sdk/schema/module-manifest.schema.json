{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-linux.local/schema/module-manifest-v2.json",
  "title": "AI-native Linux module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "display_name", "description", "module_version", "core_api", "capabilities", "dependencies", "optional_dependencies", "requested_permissions", "lifecycle", "resource_class", "default_enabled", "entrypoint"],
  "properties": {
    "schema_version": {"const": 2},
    "module_id": {"$ref": "#/$defs/dottedIdentifier"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "module_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "core_api": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/capability"}},
    "dependencies": {"$ref": "#/$defs/identifierList"},
    "optional_dependencies": {"$ref": "#/$defs/identifierList"},
    "requested_permissions": {"$ref": "#/$defs/identifierList"},
    "lifecycle": {"enum": ["on-demand", "background"]},
    "resource_class": {"enum": ["tiny", "light", "medium", "heavy"]},
    "default_enabled": {"type": "boolean"},
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module", "python_path"],
      "properties": {
        "kind": {"enum": ["python-package", "python-service"]},
        "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "python_path": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  },
  "$defs": {
    "dottedIdentifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"},
    "identifierList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dottedIdentifier"}},
    "closedInputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"}, "additionalProperties": {"type": "object", "minProperties": 1}},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "additionalProperties": {"const": false}
      }
    },
    "userIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "description", "examples"],
      "properties": {
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "examples": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input_schema", "requested_permissions"],
      "properties": {
        "id": {"$ref": "#/$defs/dottedIdentifier"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "input_schema": {"$ref": "#/$defs/closedInputSchema"},
        "requested_permissions": {"$ref": "#/$defs/identifierList"},
        "user_intent": {"$ref": "#/$defs/userIntent"}
      }
    }
  }
}

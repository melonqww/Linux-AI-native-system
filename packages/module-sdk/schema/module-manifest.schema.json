{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-linux.local/schema/module-manifest-v1.json",
  "title": "AI-native Linux module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "display_name",
    "description",
    "module_version",
    "core_api",
    "capabilities",
    "dependencies",
    "optional_dependencies",
    "requested_permissions",
    "lifecycle",
    "resource_class",
    "default_enabled",
    "entrypoint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "module_id": {"$ref": "#/$defs/dottedIdentifier"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "module_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "core_api": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedIdentifier"}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedIdentifier"}
    },
    "optional_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedIdentifier"}
    },
    "requested_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedIdentifier"}
    },
    "lifecycle": {"enum": ["on-demand", "background"]},
    "resource_class": {"enum": ["tiny", "light", "medium", "heavy"]},
    "default_enabled": {"type": "boolean"},
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module", "python_path"],
      "properties": {
        "kind": {"enum": ["python-package", "python-service"]},
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "python_path": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  },
  "$defs": {
    "dottedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    }
  }
}

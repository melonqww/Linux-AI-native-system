{
  "schema_version": 1,
  "module_id": "storage.catalog",
  "display_name": "Storage Catalog",
  "description": "Discovers volumes, catalogs file metadata and manages virtual collections.",
  "module_version": "0.1.0",
  "core_api": "1",
  "capabilities": [
    "storage.volumes.discover",
    "storage.volumes.permissions",
    "storage.catalog.scan",
    "storage.catalog.search",
    "storage.collections.manage",
    "storage.materialize.plan-copy",
    "storage.materialize.execute-copy"
  ],
  "dependencies": [],
  "optional_dependencies": [],
  "requested_permissions": [
    "storage.enumerate",
    "filesystem.read-metadata",
    "filesystem.read-content",
    "filesystem.write-content"
  ],
  "lifecycle": "on-demand",
  "resource_class": "light",
  "default_enabled": true,
  "entrypoint": {
    "kind": "python-service",
    "module": "ai_native_storage",
    "python_path": "src"
  },
  "intent_routes": [
    {
      "capability_id": "storage.materialize.plan-copy",
      "operation": "copy_results",
      "description": "Create a destination folder and copy previously found file results into it.",
      "examples": [
        "создай папку и скопируй туда найденные файлы",
        "скопируй результаты на рабочий стол",
        "сохрани найденные документы в папку",
        "copy the found files to my desktop"
      ]
    }
  ]
}

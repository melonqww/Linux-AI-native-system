{
  "schema_version": 1,
  "module_id": "documents.query",
  "display_name": "Document Query Service",
  "description": "Searches allowed local files by metadata and indexed content.",
  "module_version": "0.1.0",
  "core_api": "1",
  "capabilities": ["documents.query.search"],
  "dependencies": ["storage.catalog", "documents.index"],
  "optional_dependencies": ["documents.pdf"],
  "requested_permissions": ["filesystem.read-metadata", "filesystem.read-content"],
  "lifecycle": "on-demand",
  "resource_class": "light",
  "default_enabled": true,
  "entrypoint": {"kind": "python-package", "module": "ai_native_query", "python_path": "src"},
  "intent_routes": [
    {
      "capability_id": "documents.query.search",
      "operation": "search_documents",
      "description": "Find local files, PDF documents, text documents, or document content on allowed computer disks.",
      "examples": [
        "найди все PDF файлы на компьютере",
        "покажи мои текстовые документы",
        "найди документы по математике",
        "найди текстовый документ в котором встречается нужная фраза",
        "отыщи файл на диске",
        "find my local PDF files",
        "find a text document containing a phrase",
        "search documents on this computer"
      ]
    }
  ]
}
